# Telegram API credentials (get from https://my.telegram.org)
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_bot_token

# Bot configuration
BOT_SESSION_NAME=telegram_bot
SUDO_USERS=123456789,987654321

# Data storage
DATA_FILE=data/bot_data.json

# Anti-spam settings
FLOOD_LIMIT=5
FLOOD_TIME_LIMIT=2
GBAN_LIMIT=4